# Copy to .env on the server. Never commit the real .env.
ADMIN_USERNAME=site-admin
ADMIN_EMAIL=replace-with-controlled-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
ALLOWED_EMAIL_DOMAINS=company.example.cn
APP_SECRET_KEY=generate-a-random-secret-at-least-32-characters-long
COOKIE_SECURE=true
DATABASE_PATH=/data/nuanyan.sqlite3

# SMTP is required so password recovery works. Use a mailbox/application password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=nuanyan@example.com
